{
  "name": "bible-mobile-app",
  "version": "1.0.0",
  "main": "index.ts",
  "packageManager": "bun@1.3.9",
  "scripts": {
    "start": "bunx expo start --dev-client",
    "start:go": "bunx expo start --go",
    "android": "bunx expo run:android",
    "ios": "bunx expo run:ios",
    "prebuild": "bunx expo prebuild --clean",
    "prebuild:ios": "bunx expo prebuild -p ios --clean",
    "prebuild:android": "bunx expo prebuild -p android --clean",
    "tsc": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.0.2",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-android-widget": "^0.20.1",
    "react-native-safe-area-context": "^5.7.0"
  },
  "devDependencies": {
    "@bacons/apple-targets": "^4.0.6",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
